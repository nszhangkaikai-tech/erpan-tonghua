# ============================================================
# 耳畔童话 · CloudBase 环境变量清单（可直接粘贴到控制台）
# 粘贴路径：云开发控制台 → 环境 → 环境变量 → 批量编辑
# 说明：这是「环境级」变量，配置一次，mp-admin / mp-story /
#       mp-user / mp-voice / mp-cdkey / mp-seed 全部共享。
# ============================================================

# ① StepFun（阶跃星辰）API 密钥 ——【密钥类，勿外泄】
# ⚠️ 若当前环境已经能正常生成封面/故事（说明云端已有真实值），
#    请勿修改此行，保留云端现有值即可；只有新环境或从零配置时才填真实 key。
# 真实 key 形如 sk-xxxxxx...（从 StepFun 开放平台后台获取）
STEPFUN_API_KEY=sk-替换为你的真实StepFun密钥

# ② 文本生成模型名（StepFun 文本）
STEPFUN_MODEL=step-3.7-flash

# ③ 管理员密码盐值（HMAC 签名用，改了会使旧 admin 令牌全部失效）
#    当前云端已 pin 为 bd_dream_admin_salt_v1，保持一致即可
ADMIN_SALT=bd_dream_admin_salt_v1

# ④ 默认管理员密码（仅 seed 初始化 admin 账号时使用）
ADMIN_PASSWORD=admin123
