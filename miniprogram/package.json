{
  "name": "banmeng",
  "version": "1.0.0",
  "private": true,
  "description": "伴梦童话小程序（Taro 转译打样）",
  "template": "default",
  "typescript": true,
  "framework": "react",
  "scripts": {
    "build:weapp": "rm -rf dist && taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "type-check": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-weapp": "^4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.18.0",
    "babel-preset-taro": "4.2.1",
    "csstype": "^3.1.2",
    "miniprogram-ci": "^2.1.31",
    "sass": "^1.70.0",
    "typescript": "^5.8.2"
  }
}
